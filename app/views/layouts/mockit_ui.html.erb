<!DOCTYPE html>
<html>
  <head>
    <title>Mockit</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      :root {
        --bg: #f4f5f7;
        --surface: #ffffff;
        --border: #e2e4e9;
        --text: #1a1a1a;
        --text-muted: #6b7280;
        --accent: #3b5bfd;
        --accent-hover: #2c46d6;
        --danger: #b00020;
        --danger-bg: #fdeceb;
        --ok-bg: #e6f4ea;
        --ok-text: #1e7e34;
        --off-bg: #f1f2f4;
        --off-text: #6b7280;
        --radius: 8px;
      }
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
        padding: 2rem 1.5rem 4rem;
        background: var(--bg);
        color: var(--text);
        line-height: 1.45;
      }
      .mockit-container { max-width: 960px; margin: 0 auto; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1 { font-size: 1.4rem; margin: 0 0 1.5rem; }
      h1 a { color: var(--text); }
      h2 { font-size: 1.15rem; margin: 0 0 1rem; }
      h3 { font-size: 1rem; margin: 0 0 0.75rem; color: var(--text-muted); }
      code { background: #eef0f4; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }

      .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
      }

      .flash-alert {
        background: var(--danger-bg);
        color: var(--danger);
        border: 1px solid #f3c8c4;
        border-radius: var(--radius);
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
      }

      table { border-collapse: collapse; width: 100%; }
      th, td { padding: 0.75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
      th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-muted); font-weight: 600; }
      tbody tr:hover { background: #fafbfc; }
      tbody tr:last-child td { border-bottom: none; }

      .badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }
      .badge-on { background: var(--ok-bg); color: var(--ok-text); }
      .badge-off { background: var(--off-bg); color: var(--off-text); }

      form { margin: 0 0 0.5rem; }
      form:last-child { margin-bottom: 0; }
      .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

      input[type="text"], textarea, select {
        width: 100%;
        box-sizing: border-box;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
      }
      textarea { font-family: ui-monospace, SFMono-Regular, monospace; min-height: 6rem; }
      select { width: auto; }

      button {
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
      }
      button:hover { background: #f2f3f5; }
      form.scenario-apply button, form.scenario-reset button { border-color: var(--accent); color: var(--accent); }
      form.scenario-apply button:hover, form.scenario-reset button:hover { background: #eef1ff; }
      form.scenario-delete button, form.teardown button { border-color: var(--danger); color: var(--danger); }
      form.scenario-delete button:hover, form.teardown button:hover { background: var(--danger-bg); }
      form.mockid-switch { display: flex; gap: 0.5rem; align-items: center; }
      form.mockid-switch input { width: auto; min-width: 14rem; }

      details { margin-top: 0.5rem; }
      details summary { cursor: pointer; font-size: 0.85rem; color: var(--text-muted); }
      details[open] summary { margin-bottom: 0.5rem; }

      .hint { color: var(--text-muted); font-size: 0.85rem; }
      label { font-weight: 600; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <div class="mockit-container">
      <h1><a href="<%= ui_root_path %>">🧩 Mockit</a></h1>
      <% if flash[:alert] %>
        <p class="flash-alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
